<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:fillViewport="true" android:background="#101827">
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical" android:gravity="center" android:padding="28dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="CHAT" android:textColor="#FFFFFF" android:textSize="34sp"
            android:textStyle="bold" android:letterSpacing="0.12" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Stay close. Talk freely." android:textColor="#AAB6C8"
            android:textSize="14sp" android:layout_marginTop="8dp" android:layout_marginBottom="34dp"/>
        <EditText android:id="@+id/emailInput" android:layout_width="match_parent"
            android:layout_height="56dp" android:hint="Email address" android:inputType="textEmailAddress"
            android:singleLine="true" android:paddingHorizontal="16dp" android:backgroundTint="#35C7A5"
            android:textColor="#FFFFFF" android:textColorHint="#AAB6C8"/>
        <EditText android:id="@+id/passwordInput" android:layout_width="match_parent"
            android:layout_height="56dp" android:hint="Password" android:inputType="textPassword"
            android:singleLine="true" android:layout_marginTop="12dp" android:paddingHorizontal="16dp"
            android:backgroundTint="#35C7A5" android:textColor="#FFFFFF" android:textColorHint="#AAB6C8"/>
        <Button android:id="@+id/loginButton" android:layout_width="match_parent"
            android:layout_height="54dp" android:text="Sign in" android:textAllCaps="false"
            android:layout_marginTop="22dp" android:backgroundTint="#35C7A5" android:textColor="#101827"/>
        <Button android:id="@+id/registerButton" android:layout_width="match_parent"
            android:layout_height="54dp" android:text="Create account" android:textAllCaps="false"
            android:layout_marginTop="8dp" android:backgroundTint="#26344A" android:textColor="#FFFFFF"/>
        <ProgressBar android:id="@+id/progressBar" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:visibility="gone" android:layout_marginTop="18dp"/>
        <TextView android:id="@+id/statusText" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textColor="#F4A7A7" android:textSize="13sp"
            android:gravity="center" android:layout_marginTop="16dp"/>
    </LinearLayout>
</ScrollView>
